# ============================================================
#  Copiar este archivo como ".env" y completar los valores.
#  cp .env-example .env
# ============================================================

# Puerto donde corre la API de Flask (el frontend apunta a este puerto)
PORT=5000

# Base de datos SQLite
# DATABASE_PATH: carpeta donde vive el archivo .db. Puede ser relativa a la
# carpeta backend (./DB/) o absoluta (/home/usuario/Programacion-1/backend/DB/)
DATABASE_PATH=./DB/
DATABASE_NAME=backend.db

# JWT
JWT_SECRET_KEY=cambiar_por_una_clave_larga_y_secreta
# Duración del token en segundos (3600 = 1 hora)
JWT_ACCESS_TOKEN_EXPIRES=3600

# Carpeta donde se guardan las imágenes de las reseñas
UPLOAD_FOLDER=./uploads/
# Tamaño máximo de un archivo subido, en megabytes
MAX_UPLOAD_MB=5

# Mail (bienvenida al registrarse). Con MAIL_ENABLED=False no se envía nada.
MAIL_ENABLED=False
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=contraseña_de_aplicacion
FLASKY_MAIL_SENDER=La Rotiseria <tu_cuenta@gmail.com>

# LLM (resumen de reseñas con IA). Cualquier API compatible con OpenAI:
#   - Ollama local (gratis): LLM_API_URL=http://localhost:11434/v1/chat/completions  LLM_MODEL=llama3.2  (sin key)
#   - Groq:   LLM_API_URL=https://api.groq.com/openai/v1/chat/completions  LLM_MODEL=llama-3.1-8b-instant
#   - OpenAI: LLM_API_URL=https://api.openai.com/v1/chat/completions      LLM_MODEL=gpt-4o-mini
# Si LLM_ENABLED=False (o el servicio no responde) se devuelve un resumen estadístico.
LLM_ENABLED=False
LLM_API_URL=http://localhost:11434/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=llama3.2
LLM_TIMEOUT=20
