      "name": "1. Auth",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rotiseria.com\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token en la variable de colección para usarlo en las demás peticiones",
                  "const data = pm.response.json();",
                  "pm.test('Login OK (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_admin', data.access_token);",
                  "pm.collectionVariables.set('token', data.access_token);",
                  "console.log('Rol:', data.rol, '- token guardado');"
                ]
              }
            }
          ]
        },
