    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "token_empleado",
      "value": ""
    },
    {
      "key": "token_cliente",
      "value": ""
